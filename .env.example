# Run scripts/setup.ps1 to create .env with independently generated secrets.
POSTGRES_DB=researchhub
POSTGRES_USER=researchhub
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=researchhub
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=104857600
# For optional docker-compose.lan.yml use an IP or local hostname (no scheme).
RESEARCHHUB_HOST=researchhub.local
