{
  "$defs": {
    "MetricInput": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "metric_schema_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Schema Id"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "proposed",
            "unknown",
            "hypothesis",
            "assumed",
            "synthetic",
            "simulated",
            "measured",
            "calibrated",
            "validated",
            "reproduced",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_kind": {
          "default": "unknown",
          "enum": [
            "unknown",
            "synthetic",
            "assumed",
            "literature",
            "manufacturer",
            "measured",
            "calibrated",
            "derived"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "source_location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Location"
        },
        "derivation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derivation"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "valid_conditions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Conditions"
        },
        "artifact_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "MetricInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricInput"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    }
  },
  "required": [
    "metrics"
  ],
  "title": "MetricsBatch",
  "type": "object"
}
